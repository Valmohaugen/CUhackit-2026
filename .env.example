# Quantum DNS Shield - Environment Variables

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# IBM Quantum (optional - leave empty for simulator-only mode)
IBM_QUANTUM_TOKEN=

# AWS (for Lambda deployment)
AWS_REGION=us-east-1
AUDIT_BUCKET=

# Application
LOG_LEVEL=DEBUG
API_HOST=localhost
API_PORT=8000
DASHBOARD_PORT=8501
